# Port the Nginx front door listens on (host side)
NGINX_HOST_PORT=8080

# Port the control API listens on (host side)
API_HOST_PORT=5000

# Default TTL for a sandbox env, in seconds (30 min)
DEFAULT_TTL=1800

# Docker image for the demo app (built in Phase 2)
DEMO_APP_IMAGE=devops-sandbox-demo:latest

# Shared Docker network name that Nginx + envs sit on
PLATFORM_NETWORK=sandbox-platform-net

# Monitoring (optional extras)
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# GID of the host's `docker` group — needed by Prometheus to read the Docker
# socket for service discovery. Find with: getent group docker | cut -d: -f3
DOCKER_GID=999
